{
  "adapt_to_pi_aloha": false,
  "attention_implementation": "eager",
  "chunk_size": 50,
  "device": "cpu",
  "empty_cameras": 0,
  "freeze_vision_encoder": true,
  "input_features": {
    "observation.images.guide": {"shape": [3, 224, 224], "type": "VISUAL"},
    "observation.images.right_shoulder": {"shape": [3, 224, 224], "type": "VISUAL"},
    "observation.images.wrist": {"shape": [3, 224, 224], "type": "VISUAL"},
    "observation.state": {"shape": [16], "type": "STATE"}
  },
  "license": null,
  "max_action_dim": 32,
  "max_state_dim": 32,
  "n_action_steps": 50,
  "n_obs_steps": 1,
  "normalization_mapping": {"ACTION": "MEAN_STD", "STATE": "MEAN_STD", "VISUAL": "IDENTITY"},
  "num_steps": 10,
  "optimizer_betas": [0.9, 0.95],
  "optimizer_eps": 1e-08,
  "optimizer_lr": 2.5e-05,
  "optimizer_weight_decay": 1e-10,
  "output_features": {
    "action": {"shape": [8], "type": "ACTION"},
    "action.skill_id": {"shape": [1], "type": "ACTION"}
  },
  "private": null,
  "proj_width": 1024,
  "push_to_hub": false,
  "repo_id": null,
  "resize_imgs_with_padding": [224, 224],
  "scheduler_decay_lr": 2.5e-06,
  "scheduler_decay_steps": 30000,
  "scheduler_warmup_steps": 1000,
  "tags": null,
  "tokenizer_max_length": 48,
  "train_expert_only": false,
  "train_state_proj": true,
  "type": "pi0",
  "use_amp": false,
  "use_cache": true,
  "use_delta_joint_actions_aloha": false
}
